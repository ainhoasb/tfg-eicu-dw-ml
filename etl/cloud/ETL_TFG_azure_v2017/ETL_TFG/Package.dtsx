                      description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [PatientUnitStayID]
	  ,[AllergyType] Type
	  ,LOWER([AllergyName]) Name
	  ,[DrugHiclSeqNo] DrugHiclSeqNo
FROM [eICU Collaborative Research Database].[dbo].[Allergy]
WHERE [AllergyType] = 'Non Drug'

UNION

SELECT [PatientUnitStayID]
	  ,[AllergyType] Type
	  ,LOWER([DrugName]) Name
	  ,[DrugHiclSeqno] DrugHiclSeqNo
FROM [eICU Collaborative Research Database].[dbo].[Allergy]
WHERE [AllergyType] = 'Drug'</property>
