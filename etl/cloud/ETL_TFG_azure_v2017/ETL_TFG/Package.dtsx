                      <outputColumns>
                        <outputColumn
                          refId="Package\FASE 1 - Carga de Dimensiones\Carga Time\Time en BD.Outputs[Salida de origen de ADO NET].Columns[Offset]"
                          dataType="i4"
                          errorOrTruncationOperation="Conversión"
                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\FASE 1 - Carga de Dimensiones\Carga Time\Time en BD.Outputs[Salida de origen de ADO NET].ExternalColumns[Offset]"
