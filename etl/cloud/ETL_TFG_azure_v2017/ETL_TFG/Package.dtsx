          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{EAFB20B5-4DC6-40DB-B4F3-CBD502BC4E4B}"
              SQLTask:SqlStatementSource="USE [DW_TFG];&#xA;&#xA;-- 1. Tabla de paso 1 (limpia y calcula offset sin joins)&#xA;IF OBJECT_ID('[dbo].[Tmp_Vital_Calculada]', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[Tmp_Vital_Calculada] (&#xA;        [PatientUnitStayID] INT NULL,&#xA;        [HeartRate] NUMERIC(18,2) NULL,&#xA;        [Respiration] NUMERIC(18,2) NULL,&#xA;        [saO2] NUMERIC(18,2) NULL,&#xA;        [HoraOffset] VARCHAR(8) NULL,&#xA;        [HospitalDischargeYear] INT NULL,&#xA;        [DayNumber] INT NULL&#xA;    );&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    TRUNCATE TABLE [dbo].[Tmp_Vital_Calculada];&#xA;END&#xA;&#xA;-- 2. Tabla de paso 2 (resultado final precalculado)&#xA;IF OBJECT_ID('[dbo].[Tmp_Patient_VMFact_Precalculada]', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[Tmp_Patient_VMFact_Precalculada] (&#xA;        [PatientUnitStayID] INT NULL,&#xA;        [HeartRate] NUMERIC(18,2) NULL,&#xA;        [Respiration] NUMERIC(18,2) NULL,&#xA;        [saO2] NUMERIC(18,2) NULL,&#xA;        [HoraOffset] VARCHAR(8) NULL,&#xA;        [HospitalDischargeYear] INT NULL,&#xA;        [DayNumber] INT NULL,&#xA;        [TimeID] INT NULL,&#xA;        [VitalMeasuresID] INT NULL&#xA;    );&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    TRUNCATE TABLE [dbo].[Tmp_Patient_VMFact_Precalculada];&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
