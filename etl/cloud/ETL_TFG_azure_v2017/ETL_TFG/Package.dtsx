    <DTS:Executable
      DTS:refId="Package\FASE 2 - Carga de Hechos"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Contenedor de secuencias"
      DTS:DTSID="{BE0FCD5A-1C8E-466B-94DF-03A439551F6B}"
